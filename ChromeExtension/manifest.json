{
  "manifest_version": 3,
  "name": "MyPass",
  "version": "0.1.0",
  "description": "Autofill and save logins from MyPass",
  "permissions": ["nativeMessaging", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
