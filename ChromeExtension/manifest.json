{
  "manifest_version": 3,
  "name": "MyPass",
  "version": "0.5.0",
  "key": "",
  "description": "Autofill and save logins from MyPass",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["nativeMessaging", "activeTab", "storage", "webAuthenticationProxy", "alarms", "notifications"],
  "optional_permissions": ["privacy", "management"],
  "minimum_chrome_version": "127",
  "background": {
    "service_worker": "background-loader.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open MyPass"
    },
    "lock-vault": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Lock MyPass"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["vendor/jsQR.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": [
        "shared/entry-visuals.js",
        "shared/url-match.js",
        "shared/bridge-status.js",
        "shared/base32.js",
        "shared/form-detection.js",
        "shared/page-identifier.js",
        "shared/security-watch.js",
        "shared/autofill-settings.js",
        "shared/address-form.js",
        "shared/totp-detection.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
