    "%@\n\nIf you quit now, recent changes may be lost." : {
      "comment" : "Quit confirmation alert body; the argument is the technical reason the save failed",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nЕсли выйти сейчас, последние изменения могут быть потеряны."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nЯкщо вийти зараз, останні зміни можуть бути втрачені."
          }
        }
      }
    },
    "%@ and %@" : {
      "comment" : "Password requirements summary: joins a list of requirements; first argument is the earlier items, second the last item",
      "localizations" : {
