        }
      }
    },
    "The vault was moved, but the previous copy could not be removed." : {
      "comment" : "Vault location change sheet: message",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище перемещено, но предыдущую копию не удалось удалить."
