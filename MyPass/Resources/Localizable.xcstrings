    "That folder is no longer reachable. Choose the iCloud Drive folder again." : {
      "comment" : "Vault location change sheet: message",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта папка больше недоступна. Снова выберите папку в iCloud Drive."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця папка більше недоступна. Знову виберіть папку в iCloud Drive."
          }
        }
      }
    },
    "That location already contains a vault (%@). Choose what to do with it." : {
      "comment" : "Vault location change sheet: message when the target already holds a vault. The placeholder is the file size (for example 4 KB); the modification date is unknown",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом расположении уже есть хранилище (%@). Выберите, что с ним делать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У цьому розташуванні вже є сховище (%@). Виберіть, що з ним робити."
          }
        }
      }
    },
    "That location already contains a vault (%@, modified %@). Choose what to do with it." : {
      "comment" : "Vault location change sheet: message when the target already holds a vault. First placeholder is the file size (for example 4 KB), second is the last modification date and time",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That location already contains a vault (%1$@, modified %2$@). Choose what to do with it."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом расположении уже есть хранилище (%1$@, изменено %2$@). Выберите, что с ним делать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У цьому розташуванні вже є сховище (%1$@, змінено %2$@). Виберіть, що з ним робити."
          }
        }
      }
    },
    "That location already contains a vault (modified %@). Choose what to do with it." : {
      "comment" : "Vault location change sheet: message when the target already holds a vault. The placeholder is the last modification date and time; the file size is unknown",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом расположении уже есть хранилище (изменено %@). Выберите, что с ним делать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У цьому розташуванні вже є сховище (змінено %@). Виберіть, що з ним робити."
          }
        }
      }
    },
    "That location already contains a vault. Choose what to do with it." : {
      "comment" : "Vault location change sheet: message when the target already holds a vault and neither its size nor its modification date is known",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом расположении уже есть хранилище. Выберите, что с ним делать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У цьому розташуванні вже є сховище. Виберіть, що з ним робити."
          }
        }
      }
    },
    "That location has no vault yet. MyPass will move the vault from its current location there." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом расположении ещё нет хранилища. MyPass переместит туда хранилище из текущего расположения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У цьому розташуванні ще немає сховища. MyPass перемістить туди сховище з поточного розташування."
          }
        }
      }
    },
    "The check reads browser settings and recognized extensions. It cannot verify all autofill, passkey or macOS providers. Nothing is disabled automatically." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверка считывает настройки браузера и распознанные расширения. Она не может проверить всех поставщиков автозаполнения, ключей доступа или macOS. Ничего не отключается автоматически."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірка зчитує налаштування браузера та розпізнані розширення. Вона не може перевірити всіх постачальників автозаповнення, ключів доступу чи macOS. Нічого не вимикається автоматично."
          }
        }
      }
    },
    "The file at that location is not a MyPass vault. Nothing was changed on either side." : {
      "comment" : "Vault location change sheet: message",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл в этом расположении не является хранилищем MyPass. Ничего не изменено ни в одном из расположений."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл у цьому розташуванні не є сховищем MyPass. Нічого не змінено в жодному з розташувань."
          }
        }
      }
    },
    "The last write has not finished. If you quit now, recent changes may be lost." : {
      "comment" : "Quit confirmation alert body",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последняя запись не завершена. Если выйти сейчас, последние изменения могут быть потеряны."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останній запис не завершено. Якщо вийти зараз, останні зміни можуть бути втрачені."
          }
        }
      }
    },
    "The menu bar icon provides quick access while MyPass runs. Turning it off hides the icon but keeps the main window available from the Dock." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значок в строке меню обеспечивает быстрый доступ, пока MyPass запущен. Если его отключить, значок исчезнет, но главное окно останется доступным из Dock."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значок у рядку меню забезпечує швидкий доступ, поки MyPass запущено. Якщо його вимкнути, значок зникне, але головне вікно залишиться доступним із Dock."
          }
        }
      }
    },
    "The new location has no vault yet, so the current vault is moved there unchanged." : {
      "comment" : "Vault location change sheet: message",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В новом расположении ещё нет хранилища, поэтому текущее хранилище переносится туда без изменений."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У новому розташуванні ще немає сховища, тому поточне сховище переміщується туди без змін."
          }
        }
      }
    },
    "The new location is now ahead of the current vault: writing the result failed (%@). Try again and choose “Use the vault already at the new location” to catch up." : {
      "comment" : "Vault location change sheet: message",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новое расположение теперь содержит более новые данные, чем текущее хранилище: запись результата не удалась (%@). Повторите попытку и выберите «Использовать хранилище, уже находящееся в новом расположении», чтобы синхронизировать их."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нове розташування тепер містить новіші дані, ніж поточне сховище: запис результату не вдався (%@). Повторіть спробу та виберіть «Використати сховище, що вже є в новому розташуванні», щоб синхронізувати їх."
          }
        }
      }
    },
    "The new location now holds the current vault." : {
      "comment" : "Vault location change sheet: message",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь новое расположение содержит текущее хранилище."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тепер нове розташування містить поточне сховище."
          }
        }
      }
    },
    "The running MyPass (process %@) agreed to quit but has not finished, for example because it is waiting on a save prompt. Finish or cancel that prompt, then open MyPass again. Your vault was not opened." : {
      "comment" : "Single-instance guard alert",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущенная копия MyPass (процесс %@) согласилась выйти, но ещё не завершила работу, например из-за ожидания ответа на запрос о сохранении. Завершите или отмените этот запрос, затем снова откройте MyPass. Ваше хранилище не было открыто."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущений екземпляр MyPass (процес %@) погодився вийти, але ще не завершив роботу, наприклад через очікування відповіді на запит про збереження. Завершіть або скасуйте цей запит, а потім знову відкрийте MyPass. Ваше сховище не було відкрито."
          }
        }
      }
    },
    "The running MyPass (process %@) did not answer in time, for example because it is busy unlocking or saving. It was not asked to quit. Wait a moment, then open MyPass again. Your vault was not opened." : {
      "comment" : "Single-instance guard alert",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущенная копия MyPass (процесс %@) не ответила вовремя, например из-за занятости разблокировкой или сохранением. Её не просили выйти. Подождите немного, затем снова откройте MyPass. Ваше хранилище не было открыто."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущений екземпляр MyPass (процес %@) не відповів вчасно, наприклад через зайнятість розблокуванням чи збереженням. Його не просили вийти. Зачекайте хвилину, а потім знову відкрийте MyPass. Ваше сховище не було відкрито."
          }
        }
      }
    },
    "The running MyPass (process %@) did not close, for example because its changes could not be saved or its prompt was cancelled. It is still running. Close it yourself when you are ready, then open MyPass again. Your vault was not opened." : {
      "comment" : "Single-instance guard alert",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущенная копия MyPass (процесс %@) не закрылась, например из-за того, что её изменения не удалось сохранить или запрос был отменён. Она всё ещё работает. Закройте её сами, когда будете готовы, затем снова откройте MyPass. Ваше хранилище не было открыто."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущений екземпляр MyPass (процес %@) не закрився, наприклад через те, що його зміни не вдалося зберегти або запит було скасовано. Він досі працює. Закрийте його самі, коли будете готові, а потім знову відкрийте MyPass. Ваше сховище не було відкрито."
          }
        }
      }
    },
    "The vault at that location is still downloading from iCloud. Wait until it finishes, then try again." : {
      "comment" : "Vault location change sheet: message",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище в этом расположении ещё загружается из iCloud. Дождитесь завершения и повторите попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сховище в цьому розташуванні ще завантажується з iCloud. Дочекайтеся завершення й повторіть спробу."
          }
        }
      }
    },
    "The vault at that location uses a different password. Nothing was changed on either side." : {
      "comment" : "Vault location change sheet: message",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище в этом расположении использует другой пароль. Ничего не изменено ни в одном из расположений."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сховище в цьому розташуванні використовує інший пароль. Нічого не змінено в жодному з розташувань."
          }
        }
      }
    },
    "The vault at the new location could not be opened with your password. Nothing was changed." : {
      "comment" : "Vault location change sheet: message",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище в новом расположении не удалось открыть вашим паролем. Ничего не изменено."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сховище в новому розташуванні не вдалося відкрити вашим паролем. Нічого не змінено."
          }
        }
      }
    },
    "The vault is already at that location. Nothing was changed." : {
      "comment" : "Vault location change sheet: message",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище уже находится в этом расположении. Ничего не изменено."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сховище вже перебуває в цьому розташуванні. Нічого не змінено."
          }
        }
      }
    },
    "The vault is now at the new location." : {
      "comment" : "Vault location change sheet: message",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь хранилище находится в новом расположении."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тепер сховище перебуває в новому розташуванні."
          }
        }
      }
    },
    "The vault remains locked until you unlock it manually." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище остаётся заблокированным, пока вы не разблокируете его вручную."
